{
  "name": "@genfire/sdk",
  "version": "0.21.0",
  "private": false,
  "description": "TypeScript SDK for the Genfire Public API",
  "keywords": [
    "genfire",
    "sdk",
    "typescript",
    "javascript",
    "api",
    "ai",
    "video-generation",
    "image-generation"
  ],
  "homepage": "https://github.com/genfireai/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genfireai/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/genfireai/sdk/issues"
  },
  "author": "Genfire Team",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "individual",
    "url": "https://genfire.ai"
  },
  "packageManager": "npm@10",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
